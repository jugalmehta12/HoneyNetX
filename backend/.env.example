# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/honeynetx

# CORS
CORS_ORIGIN=http://localhost:5173

# Morgan logging
LOG_LEVEL=dev

# JWT Authentication
JWT_ACCESS_SECRET=change-me-to-a-secure-random-string
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Log Ingestion Framework
INGESTION_ENABLED=false
INGESTION_LOG_PATH=./logs/input.log
INGESTION_POLL_INTERVAL=1000
INGESTION_FORMAT=jsonl
INGESTION_MAX_FILE_SIZE=10485760
INGESTION_ENCODING=utf8
